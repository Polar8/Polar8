	      if (isOnCooldown(id)) {
	          int left = getSecondsLeft(id);
	          new ActionBar(prefix + ChatColor.GRAY + "You have " + ChatColor.BOLD + left + ChatColor.GRAY + " seconds before you can use this").sendToPlayer(p);
	          return;
	      }

	      startCooldown(id, 6, p);

	      spawnGestureDummy(p);
	  }
	  
	  private void spawnGestureDummy(final Player p) {
		    Location loc = p.getLocation().clone().add(p.getLocation().getDirection().normalize().multiply(2));

		    final ArmorStand dummy = (ArmorStand) p.getWorld().spawnEntity(loc, EntityType.ARMOR_STAND);

		    dummy.setGravity(false);
		    dummy.setVisible(false);
		    dummy.setBasePlate(false);
		    dummy.setArms(false);
		    dummy.setCustomName(ChatColor.GRAY + "Dummy");
		    dummy.setCustomNameVisible(true);
		    dummy.setHelmet(new ItemStack(Material.SKULL_ITEM, 1, (short) 3));

		    Vector back = p.getLocation().getDirection().normalize().multiply(-1.4);
		    back.setY(0.35);
		    p.setVelocity(back);

		    p.playSound(p.getLocation(), Sound.CHICKEN_EGG_POP, 1f, 1.2f);

		    new BukkitRunnable() {
		        int ticks = 0;

		        @Override
		        public void run() {
		            ticks++;

		            if (!dummy.isValid() || ticks > 10) {
		            	if (dummy.isValid()) {
		                    dummy.getWorld().playEffect(dummy.getLocation(), Effect.MAGIC_CRIT, 0);
		                    dummy.remove();
		                }

		                cancel();
		                return;
		            }

		            for (Entity ent : dummy.getNearbyEntities(12, 6, 12)) {
		                if (!(ent instanceof Creature)) continue;

		                Creature mob = (Creature) ent;

		                if (mob instanceof Wolf) continue;
		                if (mob instanceof Villager) continue;

		                mob.setTarget(dummy);
		            }
		            dummy.getWorld().playEffect(dummy.getLocation().clone().add(0, 1, 0), Effect.COLOURED_DUST, 0);
		        }
		    }.runTaskTimer(plugin, 0L, 10L);
		}
	  
	  private boolean isHolding(Player p, Material mat, String displayNameSuffix) {
	    ItemStack hand = p.getInventory().getItemInHand();
	    if (hand == null || hand.getType() != mat) return false;
	    if (!hand.hasItemMeta()) return false;
	    String name = hand.getItemMeta().getDisplayName();
	    return ChatColor.stripColor(name).endsWith(displayNameSuffix);
	  }
}
