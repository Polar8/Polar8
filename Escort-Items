	  public static void smokeBomb(Location center, double radius, double knockbackStrength, double damage) {
	        World world = center.getWorld();
	        if (world == null) return;

	        world.playEffect(center, Effect.EXPLOSION_LARGE, 0);
	        world.playSound(center, Sound.EXPLODE, 1f, 1f);

	        for (int i = 0; i < 20; i++) {
	            double offsetX = (Math.random() - 0.5) * 2 * radius;
	            double offsetY = Math.random() * radius;
	            double offsetZ = (Math.random() - 0.5) * 2 * radius;
	            Location smokeLoc = center.clone().add(offsetX, offsetY, offsetZ);
	            world.playEffect(smokeLoc, Effect.FLAME, 4);
	        }

	        for (Player player: world.getPlayers()) {
	            if (player.getLocation().distance(center) <= radius) {
	                Vector dir = player.getLocation().toVector().subtract(center.toVector()).normalize().multiply(knockbackStrength);
	                dir.setY(1);
	                player.setVelocity(dir);
	            }
	        }

	        for (Entity e : world.getNearbyEntities(center, radius, radius, radius)) {
	        	if (e instanceof LivingEntity 
	        		    && !(e instanceof Player) 
	        		    && !(e instanceof Villager)
	        		    && !(e instanceof Wolf)) {
	        		LivingEntity mob = (LivingEntity)e;
	                Vector dir = mob.getLocation().toVector().subtract(center.toVector()).normalize().multiply(knockbackStrength);
	                dir.setY(0.5);
	                mob.setVelocity(dir);
	                mob.damage(damage);
	            }
	        }
	    }
	
