	  public void castRangedSeismicSlam(Player caster) {
		    Location start = caster.getLocation().clone().add(0, 0.2, 0);
		    Vector dir = caster.getLocation().getDirection().normalize();

		    dir.setY(0);
		    dir.normalize();

		    seismicPathSlam(caster, start, dir, 16.0, 3.5, 1.4, 6.0, plugin);
		}
	  
	  public void seismicPathSlam(final Player caster,final Location start,final Vector direction,final double range,final double width,final double force,final double damage,final Main plugin) {
		    final double step = 1.0;
		    final int maxTicks = (int) Math.ceil(range / step);
		    final Set<UUID> hit = new HashSet<>();

		    new BukkitRunnable() {
		        int tick = 0;

		        @SuppressWarnings("deprecation")
		        @Override
		        public void run() {
		            if (tick > maxTicks) {
		                cancel();
		                return;
		            }

		            World world = start.getWorld();

		            double distance = tick * step;

		            Location center = start.clone().add(direction.clone().multiply(distance));

		            center.setY(world.getHighestBlockYAt(center) + 1);

		            Vector side = new Vector(-direction.getZ(), 0, direction.getX()).normalize();

		            for (double offset = -width; offset <= width; offset += 0.75) {
		                Location crack = center.clone().add(side.clone().multiply(offset));
		                crack.setY(world.getHighestBlockYAt(crack) + 0.05);

		                world.playEffect(crack,Effect.STEP_SOUND, Material.DIRT.getId());

		                if (tick % 2 == 0) {
		                    world.playEffect(crack.clone().add(0, 1.0, 0), Effect.LARGE_SMOKE, 0);
		                }
		            }

		            for (Entity entity : world.getNearbyEntities(center, width + 1.5, 4, width + 1.5)) {
		                if (!(entity instanceof LivingEntity)) continue;
		                if (entity.equals(caster)) continue;
		                if (entity instanceof Villager) continue;
		                if (hit.contains(entity.getUniqueId())) continue;

		                LivingEntity target = (LivingEntity) entity;

		                Vector kb = target.getLocation().toVector().subtract(start.toVector()).normalize().multiply(force);
		                kb.setY(1.3);
		                target.setVelocity(kb);
		                target.setFallDistance(0f);
		                target.damage(damage, caster);
		                hit.add(entity.getUniqueId());
		                world.playEffect(target.getLocation(), Effect.SPELL, 0);
		                world.playSound(target.getLocation(), Sound.STEP_GRAVEL, 1f, 0.8f);
		            }

		            tick++;
		        }
		    }.runTaskTimer(plugin, 0L, 2L);
		}

	  
	  private void smokeScreen(final Player caster, final Location center) {
		    new BukkitRunnable() {
		        int ticks = 0;

		        @Override
		        public void run() {
		            ticks++;

		            if (ticks > 6) {
		                cancel();
		                return;
		            }

		            World w = center.getWorld();

		            for (int i = 0; i < 20; i++) {
		                Location smoke = center.clone().add(ThreadLocalRandom.current().nextDouble(-2.5, 2.5),ThreadLocalRandom.current().nextDouble(0.2, 2.5), ThreadLocalRandom.current().nextDouble(-2.5, 2.5));
		                w.playEffect(smoke, Effect.LARGE_SMOKE, 0);
		            }

		            for (Entity ent : w.getNearbyEntities(center, 3.5, 3, 3.5)) {
		                if (!(ent instanceof LivingEntity)) continue;
		                if (ent instanceof Player) continue;
		                LivingEntity mob = (LivingEntity) ent;
		                mob.damage(1.0, caster);
		                mob.addPotionEffect(new PotionEffect(PotionEffectType.SLOW, 60, 255));
		                mob.setVelocity(new Vector(0, 0, 0));
		            }
		        }
		    }.runTaskTimer(plugin, 0L, 5L);
		}
  
