### Custom Items for Escort Minigame ###

public class EscortListeners implements Listener {

	  private final Main plugin;
	  private final Map<UUID, Long> expiryMap = new HashMap<>();
	  private final String prefix = ChatColor.LIGHT_PURPLE + ChatColor.BOLD.toString() + "[Escort] ";
	  private static final String META_KEY = "healblock";
	  private final Map<UUID, Integer> windShots = new HashMap<>();
	  private final Map<UUID, Integer> knockbackUses = new HashMap<>();
	  private final Map<UUID, Integer> sniperShots = new HashMap<>();
	  private final Set<Location> activeIceCageCenters = new HashSet<>();
	  public EscortListeners(Main plugin) {
	    this.plugin = plugin;
	  }
	  
	  private boolean isNamed(ItemStack item, String name) {
		    if (item == null || !item.hasItemMeta()) return false;
		    if (!item.getItemMeta().hasDisplayName()) return false;

		    return ChatColor.stripColor(item.getItemMeta().getDisplayName())
		            .equalsIgnoreCase(name);
		}

	  private boolean isOnCooldown(UUID id) {
	    Long exp = expiryMap.get(id);
	    return exp != null && System.currentTimeMillis() < exp;
	  }

	  private int getSecondsLeft(UUID id) {
	    Long exp = expiryMap.get(id);
	    if (exp == null) return 0;
	    long msLeft = exp - System.currentTimeMillis();
	    return (int)Math.ceil(msLeft / 1000.0);
	  }

	  private void startCooldown(UUID id, int seconds, Player player) {
	    expiryMap.put(id, System.currentTimeMillis() + seconds * 1000L);
	    plugin.getServer().getScheduler().runTaskLater(plugin, () -> {
	      expiryMap.remove(id);
	      new ActionBar(prefix + ChatColor.GRAY + "You can use ability").sendToPlayer(player);
	    }, seconds * 20L);
	  }
	  
	  @EventHandler
	  public void onSupplyItemUse(PlayerInteractEvent e) {
	      Player p = e.getPlayer();
	      ItemStack item = p.getItemInHand();

	      if (item == null) return;

	      if (isNamed(item, "Wind Stick")) {
	          useWindStick(p);
	      } else if (isNamed(item, "Spear")) {
	          useSpear(p);
	          consumeOne(p);
	      } else if (isNamed(item, "Poison Rod")) {
	    	  usePoisonRod(p);
	      } else if (isNamed(item, "Ice Age")) {
	          useIceAge(p);
	          consumeOne(p);
	      } else if (isNamed(item, "Moo Pal")) {
	          spawnMooPal(p);
	          consumeOne(p);
	      } else if (isNamed(item, "Sniper Rifle")) {
	          useSniperRifle(p);
	      }
	  }
	  
	  private void useWindStick(Player p) {
		    UUID id = p.getUniqueId();
		    int shots = windShots.getOrDefault(id, 6);

		    if (shots <= 0) {
		        windShots.remove(id);
		        consumeOne(p);
		        p.sendMessage(prefix + ChatColor.RED + "Wind Stick broke!");
		        return;
		    }
		    windShots.put(id, shots - 1);

		    Vector dir = p.getLocation().getDirection().normalize();
		    Location center = p.getLocation().clone().add(dir.clone().multiply(2));

		    for (double y = 0; y < 4; y += 0.35) {
		        double radius = 0.5 + y * 0.25;
		        double spin = y * 2.5;

		        for (int i = 0; i < 3; i++) {
		            double angle = spin + (i * Math.PI * 2 / 3);

		            Location effectLoc = center.clone().add(Math.cos(angle) * radius,y,Math.sin(angle) * radius);

		            p.getWorld().playEffect(effectLoc, Effect.CLOUD, 0);
		            p.getWorld().playEffect(effectLoc, Effect.LARGE_SMOKE, 0);
		        }
		    }

		    for (Entity ent : p.getNearbyEntities(7, 4, 7)) {
		        if (!(ent instanceof LivingEntity)) continue;
		        if (ent.equals(p)) continue;

		        LivingEntity target = (LivingEntity) ent;

		        target.setVelocity(dir.clone().multiply(1.8).setY(0.6));
		        target.damage(3.0, p);
		    }

		    p.playSound(p.getLocation(), Sound.ENDERDRAGON_WINGS, 1.5f, 1.2f);

		    if (shots - 1 <= 0) consumeOne(p);
		}
	  private void usePoisonRod(Player p) {
		    UUID id = p.getUniqueId();
		    int uses = knockbackUses.getOrDefault(id, 10);

		    if (uses <= 0) {
		        knockbackUses.remove(id);
		        consumeOne(p);
		        p.sendMessage(prefix + ChatColor.RED + "Poison Rod broke!");
		        return;
		    }

		    knockbackUses.put(id, uses - 1);

		    for (Entity ent : p.getNearbyEntities(5, 3, 5)) {
		        if (!(ent instanceof LivingEntity)) continue;
		        if (ent.equals(p)) continue;

		        LivingEntity target = (LivingEntity) ent;

		        target.damage(2.0, p);

		        target.addPotionEffect(new PotionEffect(PotionEffectType.POISON,20 * 4,1));

		        target.addPotionEffect(new PotionEffect(PotionEffectType.SLOW,20 * 2,1));

		        target.getWorld().playEffect(target.getLocation(), Effect.MOBSPAWNER_FLAMES, 0);
		    }

		    p.playSound(p.getLocation(), Sound.BLAZE_BREATH, 1f, 1.2f);

		    if (uses - 1 <= 0) consumeOne(p);
		}
	  private void useSpear(final Player p) {
		    Location eye = p.getEyeLocation();
		    Vector dir = eye.getDirection().normalize();

		    final Item spear = p.getWorld().dropItem(
		            eye.clone().add(dir),
		            new ItemStack(Material.IRON_SPADE)
		    );

		    spear.setPickupDelay(Integer.MAX_VALUE);
		    spear.setVelocity(dir.multiply(1.8));

		    new BukkitRunnable() {
		        int ticks = 0;

		        public void run() {
		            ticks++;

		            if (!spear.isValid() || ticks > 60) {
		                spear.remove();
		                cancel();
		                return;
		            }

		            for (Entity ent : spear.getNearbyEntities(1.3, 1.3, 1.3)) {
		                if (!(ent instanceof LivingEntity)) continue;
		                if (ent.equals(p)) continue;

		                ((LivingEntity) ent).damage(10.0, p);
		                ent.setVelocity(p.getLocation().getDirection().normalize().multiply(1.4).setY(0.4));

		                spear.getWorld().playEffect(spear.getLocation(), Effect.CRIT, 0);
		                spear.remove();
		                cancel();
		                return;
		            }
		        }
		    }.runTaskTimer(plugin, 0L, 1L);
		}
	  private void useIceAge(Player p) {
		    Location center = p.getLocation().getBlock().getLocation();
		    activeIceCageCenters.add(center);

		    List<Block> placed = new ArrayList<>();

		    int radius = 2;
		    int height = 3;
		    for (int y = 0; y <= height; y++) {
		        for (int x = -radius; x <= radius; x++) {
		            for (int z = -radius; z <= radius; z++) {

		                boolean wall = Math.abs(x) == radius || Math.abs(z) == radius;
		                boolean roof = y == height;
		                boolean floor = y == 0;

		                if (!wall && !roof && !floor) continue;

		                Block b = center.clone().add(x, y, z).getBlock();

		                if (b.getType() == Material.AIR) {
		                    b.setType(Material.PACKED_ICE);
		                    placed.add(b);
		                }
		            }
		        }
		    }

		    p.getWorld().playSound(center, Sound.GLASS, 2f, 0.6f);

		    new BukkitRunnable() {
		        int ticks = 0;

		        public void run() {
		            ticks++;

		            for (Entity ent : center.getWorld().getNearbyEntities(center, 7, 6, 5)) {
		                if (!(ent instanceof LivingEntity)) continue;
		                if (ent instanceof Player) continue;

		                LivingEntity mob = (LivingEntity) ent;

		                mob.addPotionEffect(new PotionEffect(PotionEffectType.SLOW, 1000000, 255));

		                mob.setMetadata("iceAgeFrozen", new FixedMetadataValue(plugin, true));

		                center.getWorld().playEffect(mob.getLocation(), Effect.SNOW_SHOVEL, 0);
		            }

		            if (ticks >= 15) {
		                for (Block b: placed) {
		                    if (b.getType() == Material.PACKED_ICE) {
		                        b.setType(Material.AIR);
		                    }
		                }

		                for (int y = 0; y <= height; y++) {
		                    for (int x = -radius - 1; x <= radius + 1; x++) {
		                        for (int z = -radius - 1; z <= radius + 1; z++) {
		                            Block b = center.clone().add(x, y, z).getBlock();

		                            if (b.getType() == Material.PACKED_ICE) {
		                                b.setType(Material.AIR);
		                            }
		                        }
		                    }
		                }

		                activeIceCageCenters.remove(center);
		                cancel();
		            }
		        }
		    }.runTaskTimer(plugin, 0L, 10L);
		}
	  
	  @EventHandler
	  public void onFrozenMobDamage(EntityDamageByEntityEvent e) {
	      if (!(e.getEntity() instanceof LivingEntity)) return;
	      if (e.getEntity() instanceof Player) return;

	      LivingEntity mob = (LivingEntity) e.getEntity();

	      if (!mob.hasMetadata("iceAgeFrozen")) return;

	      mob.damage(9999.0);
	  }
	  
	  private void spawnMooPal(final Player p) {
		    final MushroomCow cow = (MushroomCow) p.getWorld().spawnEntity(p.getLocation().clone().add(1, 0, 1), EntityType.MUSHROOM_COW);
		    cow.setCustomName(ChatColor.RED + "Moo Pal");
		    cow.setCustomNameVisible(true);
		    cow.setMaxHealth(20.0);
		    cow.setHealth(20.0);

		    cow.getWorld().playSound(cow.getLocation(), Sound.COW_IDLE, 1f, 1.2f);

		    new BukkitRunnable() {
		        int ticks = 0;

		        @Override
		        public void run() {
		            ticks += 10;

		            if (!cow.isValid() || cow.isDead() || ticks >= 20 * 20) {
		                if (cow.isValid()) {
		                    cow.getWorld().playEffect(cow.getLocation(), Effect.HEART, 0);
		                    cow.remove();
		                }

		                cancel();
		                return;
		            }

		            for (Entity ent : cow.getNearbyEntities(8, 4, 8)) {
		                if (!(ent instanceof Player)) continue;

		                Player nearby = (Player) ent;

		                nearby.addPotionEffect(new PotionEffect(PotionEffectType.INCREASE_DAMAGE,100,0));

		                if (ticks % 40 == 0) {
		                    nearby.playSound(nearby.getLocation(), Sound.COW_IDLE, 0.5f, 1.4f);
		                }
		            }

		            cow.getWorld().playEffect(cow.getLocation().clone().add(0, 1.2, 0),Effect.HEART,0);
		        }
		    }.runTaskTimer(plugin, 0L, 10L);
		}
	  private void useSniperRifle(Player p) {
		    UUID id = p.getUniqueId();
		    int shots = sniperShots.getOrDefault(id, 6);

		    if (shots <= 0) {
		        sniperShots.remove(id);
		        consumeOne(p);
		        p.sendMessage(ChatColor.RED + "Sniper Rifle broke!");
		        return;
		    }

		    sniperShots.put(id, shots - 1);

		    Snowball bullet = p.launchProjectile(Snowball.class);
		    bullet.setVelocity(p.getLocation().getDirection().normalize().multiply(3.0));
		    bullet.setMetadata("sniperBullet", new FixedMetadataValue(plugin, p.getUniqueId().toString()));

		    p.playSound(p.getLocation(), Sound.FIREWORK_BLAST, 1f, 1.4f);

		    if (shots - 1 <= 0) consumeOne(p);
		}
	  
	  @EventHandler
	  public void onSniperHit(ProjectileHitEvent e) {
	      if (!(e.getEntity() instanceof Snowball)) return;
	      if (!e.getEntity().hasMetadata("sniperBullet")) return;

	      Snowball snowball = (Snowball) e.getEntity();

	      Location loc = snowball.getLocation();

	      for (Entity ent : loc.getWorld().getNearbyEntities(loc, 1.5, 1.5, 1.5)) {
	          if (!(ent instanceof LivingEntity)) continue;
	          if (ent instanceof Player) continue;

	          ((LivingEntity) ent).damage(14.0);
	          loc.getWorld().playEffect(loc, Effect.CRIT, 0);
	          break;
	      }

	      snowball.remove();
	  }
	  
	  private void consumeOne(Player p) {
		    ItemStack item = p.getItemInHand();

		    if (item == null) return;

		    if (item.getAmount() <= 1) {
		        p.setItemInHand(null);
		    } else {
		        item.setAmount(item.getAmount() - 1);
		    }

		    p.updateInventory();
		}

	  @EventHandler
	  public void onProxyHeal(PlayerInteractEvent e) {
	    Player p = e.getPlayer();
	    if (e.getAction() != Action.RIGHT_CLICK_AIR) return;
	    if (!isHolding(p, Material.STONE_AXE, "Proxy Heal")) return;
	    World world = Bukkit.getWorld("Escort");
	    UUID id = p.getUniqueId();
	    if (isOnCooldown(id)) {
	      int left = getSecondsLeft(id);
	      new ActionBar(prefix + ChatColor.GRAY + "You have " + ChatColor.BOLD + left + ChatColor.GRAY + " seconds before you can use this").sendToPlayer(p);
	      return;
	    }
	    startCooldown(id, 5, p);
	    giveWorldRegen(world);
	  }
	  
	  public void giveWorldRegen(World world) {
	        int durationTicks = 3 * 20;
	        int amplifier = 2;
	        PotionEffect regenEffect = new PotionEffect(
	            PotionEffectType.REGENERATION,
	            durationTicks,
	            amplifier
	        );
	        for (Player player: world.getPlayers()) {
	            player.addPotionEffect(regenEffect);
	        }
	    }
	  
