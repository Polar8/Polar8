	@EventHandler
	public void onPlayerMove(PlayerMoveEvent event) {
	    Player movingPlayer = event.getPlayer();
	    if (movingPlayer.isInsideVehicle()) {
	        Entity vehicle = movingPlayer.getVehicle();
	        for (Location crateLoc: activeCrateSpots.keySet()) {
	            if (vehicle.getLocation().distance(crateLoc) <= 6) {
	                Vector knock = vehicle.getLocation().toVector().subtract(crateLoc.toVector()).normalize().multiply(5);
	                knock.setY(2);
	                vehicle.setVelocity(knock);
	                ActionBar actionBar = new ActionBar(prefix + ChatColor.GRAY + "You're too close, don't bother the opener!");
	                actionBar.sendToPlayer(movingPlayer);
	                movingPlayer.playSound(movingPlayer.getLocation(), Sound.CAT_MEOW, 2, 3);
	                return;
	            }
	        }
	    }
	    for (Player potentialOpener: Bukkit.getOnlinePlayers()) {
	        if (potentialOpener.equals(movingPlayer)) continue;

	        boolean hasKey = false;
	        for (ItemStack item : potentialOpener.getInventory().getContents()) {
	            if (item != null && item.getType() == Material.STICK &&
	                item.hasItemMeta() && item.getItemMeta().hasDisplayName() &&
	                ChatColor.stripColor(item.getItemMeta().getDisplayName()).equalsIgnoreCase("Nightbox Key")) {
	                hasKey = true;
	                break;
	            }
	        }
	        if (!hasKey) continue;
	        for (Location crateLoc: activeCrateSpots.keySet()) {
	            if (potentialOpener.getLocation().distance(crateLoc) <= 2 &&
	                movingPlayer.getLocation().distance(crateLoc) <= 6) {
	                Vector knock = movingPlayer.getLocation().toVector().subtract(crateLoc.toVector()).normalize().multiply(5);
	                knock.setY(2);
	                movingPlayer.setVelocity(knock);
	                ActionBar actionBar = new ActionBar(prefix + ChatColor.GRAY + "You're too close, don't bother the opener!");
	                actionBar.sendToPlayer(movingPlayer);
	                movingPlayer.playSound(movingPlayer.getLocation(), Sound.CAT_MEOW, 2, 3);
	                return;
	            }
	        }
	    }
	}

	
	private void teleportBackLater(Player player, Map<UUID, Location> previousLocations) {
	    Location back = previousLocations.remove(player.getUniqueId());
	    if (back != null) {
	        Bukkit.getScheduler().runTaskLater(Main.getInstance(), () -> {
	            player.teleport(back);
	            for (ItemStack item : player.getInventory().getContents()) {
	                if (item != null && item.getType() == Material.STICK &&
	                    item.hasItemMeta() && item.getItemMeta().hasDisplayName() &&
	                    ChatColor.stripColor(item.getItemMeta().getDisplayName()).equalsIgnoreCase("Nightbox Key")) {
	                    player.getInventory().remove(item);
	                    restoreLobbyItems(player);
	                    break;
	                }
	            }

	        }, 100L);
	    }
	}
	
	@EventHandler
	public void onPlayerMove1(PlayerMoveEvent event) {
	    Player player = event.getPlayer();
	    UUID playerId = player.getUniqueId();

	    if (activeCrateSpots.containsValue(playerId)) {
	        Location platform = activeCrateSpots.entrySet().stream()
	                .filter(e -> e.getValue().equals(playerId))
	                .map(Map.Entry::getKey)
	                .findFirst()
	                .orElse(null);

	        if (platform != null) {
	            Location to = event.getTo();

	            double distance = to.distance(platform);
	            if (distance > 3.5 && distance < 6.0) {
	                Vector push = platform.toVector().subtract(to.toVector()).normalize().multiply(0.5);
	                push.setY(0.1);
	                player.setVelocity(push);

	                ActionBar actionBar = new ActionBar(prefix + ChatColor.GRAY + "You're wandering off... stay on the platform!");
	                actionBar.sendToPlayer(player);
	            } else if (distance >= 6.0) {
	                player.teleport(platform.clone().add(0, 1, 0));
	                ActionBar actionBar = new ActionBar(prefix + ChatColor.GRAY + "Open your nightbox before leaving!");
	                actionBar.sendToPlayer(player);
	            }
	        }
	    }
	}
	
	@EventHandler
	public void onCommandPreprocess(PlayerCommandPreprocessEvent event) {
	    Player player = event.getPlayer();
	    if (activeCrateSpots.containsValue(player.getUniqueId())) {
	        event.setCancelled(true);
	        ActionBar actionBar = new ActionBar(prefix + ChatColor.GRAY + "Open your nightbox before using commands!");
            actionBar.sendToPlayer(player);
	    }
	}
	
	@EventHandler
	public void onPlayerQuit(PlayerQuitEvent e) {
	    Player player = e.getPlayer();
	    UUID id = player.getUniqueId();
	    for (Iterator<Map.Entry<Location, UUID>> it = activeCrateSpots.entrySet().iterator(); it.hasNext();) {
	        Map.Entry<Location, UUID> entry = it.next();
	        if (entry.getValue().equals(id)) {
	            Location platform = entry.getKey();
	            it.remove();
	            Bukkit.getScheduler().runTask(Main.getInstance(), () -> {
	                Location[] crates = {
	                    platform.clone().add(2, 0, 0),
	                    platform.clone().add(-2, 0, 0)
	                };
	                for (Location crateLoc: crates) {
	                    crateLoc.getBlock().setType(Material.AIR);
	                }

	                platform.getWorld()
	                    .getNearbyEntities(platform.clone().add(0, 1, 0), 5, 5, 5)
	                    .stream()
	                    .filter(ent -> (ent instanceof ArmorStand && ChatColor.stripColor(((ArmorStand) ent).getCustomName()).equals("Cosmetic Crate"))
	                                || (ent instanceof FallingBlock && ((FallingBlock) ent).getMaterial() == Material.ENDER_CHEST))
	                    .forEach(Entity::remove);
	            });
	            Bukkit.getScheduler().runTaskAsynchronously(Main.getInstance(), () -> {
	                Main.getInstance();
					try (PreparedStatement ps = Main.getConnection().prepareStatement(
	                        "REPLACE INTO pending_refunds (player_uuid, message, amount, timestamp) VALUES (?, ?, ?, ?)")) {
	                    ps.setString(1, id.toString());
	                    ps.setString(2, "You were refunded 100 coins for quitting during a Nightbox!");
	                    ps.setInt(3, 100);
	                    ps.setLong(4, System.currentTimeMillis());
	                    ps.executeUpdate();
	                    Bukkit.getLogger().info("[NightBox] Logged refund for: " + player.getName());
	                } catch (SQLException ex) {
	                    ex.printStackTrace();
	                }
	            });
	            break;
	        }
	    }
	}

	@EventHandler
	public void onPlayerJoin(PlayerJoinEvent e) {
	    Player player = e.getPlayer();
	    UUID id = player.getUniqueId();

	    Bukkit.getScheduler().runTaskAsynchronously(Main.getInstance(), () -> {
	        try (PreparedStatement ps = Main.getConnection().prepareStatement(
	                "SELECT message, amount FROM pending_refunds WHERE player_uuid = ?")) {
	            ps.setString(1, id.toString());

	            try (ResultSet rs = ps.executeQuery()) {
	                if (rs.next()) {
	                    String message = rs.getString("message");
	                    int amount = rs.getInt("amount");

	                    Bukkit.getScheduler().runTask(Main.getInstance(), () -> {
	                        for (ItemStack item : player.getInventory().getContents()) {
	                            if (item != null && item.getType() == Material.STICK &&
	                                item.hasItemMeta() && item.getItemMeta().hasDisplayName() &&
	                                ChatColor.stripColor(item.getItemMeta().getDisplayName()).equalsIgnoreCase("Nightbox Key")) {
	                                player.getInventory().remove(item);
	                                break;
	                            }
	                        }

	                        Coins.addCoins(player, amount);
	                        new ActionBar(prefix + message).sendToPlayer(player);

	                        int coins = Coins.getCoins(player);
	                        int shards = EvoShards.getShards(player);
	                        String rankName = this.rankManager.getRank(player).getPrefix();
	                        String serverName = "Lobby";
	                        this.rankManager.updateSidebar(player, coins, shards, rankName, serverName);
	                        Bukkit.getLogger().info("Refunded " + amount + " coins to " + player.getName());
	                    });

	                    try (PreparedStatement delete = Main.getConnection().prepareStatement(
	                            "DELETE FROM pending_refunds WHERE player_uuid = ?")) {
	                        delete.setString(1, id.toString());
	                        delete.executeUpdate();
	                    }
	                }
	            }
	        } catch (SQLException ex) {
	            ex.printStackTrace();
	        }
	    });
	}

	public void restoreLobbyItems(Player p) {
	    PlayerInventory inventory = p.getInventory();
	    ItemStack cosmetics = new ItemStack(Material.CHEST);
	    ItemMeta cosmeticsMeta = cosmetics.getItemMeta();
	    cosmeticsMeta.setDisplayName(ChatColor.LIGHT_PURPLE + "Cosmetics");
	    cosmeticsMeta.setLore(Collections.singletonList(ChatColor.RED + "Have lots of fun!"));
	    cosmetics.setItemMeta(cosmeticsMeta);
	    inventory.setItem(4, cosmetics);
	    ItemStack selector = new ItemStack(Material.COMPASS);
	    ItemMeta selectorMeta = selector.getItemMeta();
	    selectorMeta.setDisplayName(ChatColor.LIGHT_PURPLE + "Game Selector");
	    selectorMeta.setLore(Collections.singletonList(ChatColor.RED + "Choose a minigame"));
	    selector.setItemMeta(selectorMeta);
	    inventory.setItem(1, selector);
	    ItemStack prefs = new ItemStack(Material.REDSTONE_COMPARATOR);
	    ItemMeta prefsMeta = prefs.getItemMeta();
	    prefsMeta.setDisplayName(ChatColor.LIGHT_PURPLE + "Prefs");
	    prefsMeta.setLore(Collections.singletonList(ChatColor.RED + "Settings menu"));
	    prefs.setItemMeta(prefsMeta);
	    inventory.setItem(7, prefs);
	}
	
	
	private void releaseCrateSpots(List<Location> platforms) {
	    for (Location platform: platforms) {
	        activeCrateSpots.remove(platform);
	    }
	}
