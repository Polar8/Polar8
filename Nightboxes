	}
	
	public final Map<Location, UUID> activeCrateSpots = new HashMap<>();

	private final List<Location> cratePlatforms = Arrays.asList(new Location(Bukkit.getWorld("world"), 268, 123, -337));
	
	public String prefix = ChatColor.LIGHT_PURPLE + ChatColor.BOLD.toString() + "[Nightbox] ";
	
	public void startCrateSequence(Player player) {
	    for (Location platform: cratePlatforms) {
	        if (!activeCrateSpots.containsKey(platform)) {
	            activeCrateSpots.put(platform, player.getUniqueId());
	            Location teleportLoc = platform.clone().add(0, 1, 0);
	            player.teleport(teleportLoc);
	            player.playSound(teleportLoc, Sound.NOTE_PLING, 5.0F, 3.0F);
	            ItemStack key = new ItemStack(Material.STICK);
	            ItemMeta meta = key.getItemMeta();
	            meta.setDisplayName(ChatColor.GOLD + "" + ChatColor.BOLD + "Nightbox Key");
	            meta.setLore(Arrays.asList(ChatColor.GRAY + ""));
	            key.setItemMeta(meta);
	            player.getInventory().setItem(10, key);
	            Location loc = player.getLocation();
	            double radius = 1.0;
	            for (int i = 0; i < 360; i += 5) {
	                double angle = Math.toRadians(i);
	                double x = radius * Math.cos(angle);
	                double z = radius * Math.sin(angle);
	                Location flameLoc = loc.clone().add(x, 0, z);
	                flameLoc.getWorld().playEffect(flameLoc, Effect.CRIT, 0);
	            }
	            Bukkit.broadcastMessage(prefix + player.getDisplayName() + ChatColor.GRAY + " is opening a nightbox!");
	            spawnCrateAt(player, platform.clone().add(2, 0, 0));
	            spawnCrateAt(player, platform.clone().add(-2, 0, 0));
	            return;
	        }
	    }
	    ActionBar actionBar = new ActionBar(prefix + ChatColor.RED + "Areas filled up! Here's your refund, try again later!");
	    actionBar.sendToPlayer(player);
	    player.playSound(player.getLocation(), Sound.NOTE_BASS, 2, 2);
	    Coins.addCoins(player, 100);
	    int coins = Coins.getCoins(player);
      int shards = EvoShards.getShards(player);
      String rankName = this.rankManager.getRank(player).getPrefix();
      String serverName = "Lobby";
      this.rankManager.updateSidebar(player, coins, shards, rankName, serverName);
	    restoreLobbyItems(player);
	}
	
	private void spawnCrateAt(Player player, Location target) {
	    target.getBlock().setType(Material.ENDER_CHEST);
	    ArmorStand stand = (ArmorStand) target.getWorld().spawn(target.clone().add(0.5, 1, 0.5), ArmorStand.class);
	    stand.setVisible(false);
	    stand.setGravity(false);
	    stand.setCustomName(ChatColor.LIGHT_PURPLE + "Cosmetic Crate");
	    stand.setCustomNameVisible(true);
	    stand.setMarker(true);
	    spawnFirework(target.clone().add(0.5, 1, 0.5));
	    double radius = 1.0;
	    for (int i = 0; i < 360; i += 10) {
	        double angle = Math.toRadians(i);
	        double x = radius * Math.cos(angle);
	        double z = radius * Math.sin(angle);
	        Location flameLoc = target.clone().add(x, 1, z);
	        flameLoc.getWorld().playEffect(flameLoc, Effect.MOBSPAWNER_FLAMES, 0);
	    }
	}
	
	private void spawnFirework(Location loc) {
	    Firework fw = (Firework) loc.getWorld().spawn(loc, Firework.class);
	    FireworkMeta fwm = fw.getFireworkMeta();
	    fwm.addEffect(FireworkEffect.builder().with(FireworkEffect.Type.BURST).withColor(Color.PURPLE).withFade(Color.BLUE).flicker(true).trail(true).build());
	    fwm.setPower(1);
	    fw.setFireworkMeta(fwm);
	}
