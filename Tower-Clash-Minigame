    	private boolean isWater(Material material) {
    	    return material == Material.WATER || material == Material.STATIONARY_WATER;
    	}
    	
    	private boolean isInWater(Player player) {
    	    Location loc = player.getLocation();
    	    Block below = loc.clone().subtract(0, 1, 0).getBlock();
    	    Block feet = loc.getBlock();
    	    Block head = player.getEyeLocation().getBlock();
    	    Block aboveHead = loc.clone().add(0, 1, 0).getBlock();
    	    return isWater(below.getType()) || isWater(feet.getType()) ||
    	           isWater(head.getType()) || isWater(aboveHead.getType());
    	}
    	private boolean isWoodFence(Material material) {
    	    return material.name().endsWith("_FENCE") && !material.name().contains("NETHER");
    	}
    	
    	
    @EventHandler(ignoreCancelled = true)
    public void onEntityTarget(EntityTargetLivingEntityEvent e) {
        if (!isTCRunning()) return;

        Entity entity = e.getEntity();
        LivingEntity target = e.getTarget();
        if (target == null) return;
        if (entity.hasMetadata("goletarget")) {
            if (!(target instanceof Snowman
                  && ((Snowman)target).getCustomName().endsWith("Golem"))) {
                e.setCancelled(true);
            }
            return;
        }
        
        if (target instanceof Player) {
            e.setCancelled(true);
            return;
        }

        
        if (!(entity instanceof Creature) || !entity.hasMetadata("team")) {
            return;
        }
        if (!target.hasMetadata("team")) {
            e.setCancelled(true);
            return;
        }

        
        String teamEnt = entity.getMetadata("team").stream().filter(md -> md.getOwningPlugin() == plugin).findFirst().map(md -> md.asString()).orElse("");
        String teamTgt = target.getMetadata("team").stream().filter(md -> md.getOwningPlugin() == plugin).findFirst().map(md -> md.asString()).orElse("");
        if (teamEnt.equals(teamTgt)) {
            e.setCancelled(true);
        }
    }
    
    private Location getTeamSpawn(Player player) {
        TeamData team = playerTeams.get(player.getUniqueId());
        if (team == null) return null;

        World world = Bukkit.getWorld("TowerClash");

        if (team == redTeam) {
            return new Location(world, 141, 87, -52);
        } else if (team == blueTeam) {
            return new Location(world, 178, 87, -51);
        }

        return null;
    }
    
    private void startOvertime() {
        if (overtimeStarted) return;
        overtimeStarted = true;

        Bukkit.broadcastMessage(prefix + ChatColor.RED
                + "Overtime! Warrior Zombies have entered the battlefield!");

        World w = Bukkit.getWorld("TowerClash");
        if (w == null) return;

        for (int i = 0; i < 5; i++) {
            Location spawn = new Location(w, 140 + random.nextInt(40), 87, -70 + random.nextInt(40));
            Zombie z = (Zombie) w.spawnEntity(spawn, EntityType.ZOMBIE);
            z.setMetadata("overtimeZombie", new FixedMetadataValue(plugin, true));
            z.setMetadata("team", new FixedMetadataValue(plugin, "Overtime"));
            z.setRemoveWhenFarAway(false);
            z.getEquipment().setHelmet(new ItemStack(Material.IRON_HELMET));
            z.getEquipment().setChestplate(new ItemStack(Material.IRON_CHESTPLATE));
            z.getEquipment().setLeggings(new ItemStack(Material.IRON_LEGGINGS));
            z.getEquipment().setBoots(new ItemStack(Material.IRON_BOOTS));
            z.getEquipment().setItemInHand(new ItemStack(Material.IRON_SWORD));
            z.setMaxHealth(30.0);
            z.setHealth(30.0);
            applyOvertimeZombieAI(z);

        }
    }
    
