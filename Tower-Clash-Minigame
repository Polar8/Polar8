    private void spawnSingleGolem(Location loc, TeamData team) {
        final Location home = loc.clone().add(0, 1, 0);
        final Snowman golem = (Snowman) world.spawnEntity(home, EntityType.SNOWMAN);
        golem.setMaxHealth(50);
        golem.setHealth(50);
        golem.setCustomNameVisible(true);
        tagMob(golem, team.getName());

        new BukkitRunnable() {
            @Override
            public void run() {
                if (!isTCRunning() || golem.isDead()) {
                    cancel();
                    return;
                }
                golem.teleport(home);
                double hp = Math.round(golem.getHealth() * 10) / 10.0;
                double max = Math.round(golem.getMaxHealth() * 10) / 10.0;
                golem.setCustomName(ChatColor.GOLD + team.getName() + " Golem " + hp + " / " + max + "❤");
            }
        }.runTaskTimer(plugin, 0L, 10L);
    }

    @EventHandler(ignoreCancelled = true)
    public void onGolemDamage(EntityDamageByEntityEvent e) {
        if (!isTCRunning()) return;
        Entity dam = e.getDamager();
        if (dam instanceof Projectile) {
            Projectile pr = (Projectile) dam;
            if (pr.getShooter() instanceof Entity) dam = (Entity) pr.getShooter();
        }
        if (!(e.getEntity() instanceof Snowman) ||
            !(dam instanceof LivingEntity) ||
            !e.getEntity().hasMetadata("team")) {
            return;
        }
        String golemTeam = e.getEntity().getMetadata("team").get(0).asString();
        String damTeam = ((LivingEntity) dam).getMetadata("team").stream().filter(md -> md.getOwningPlugin() == plugin).map(MetadataValue::asString).findFirst().orElse("");
        if (golemTeam.equals(damTeam)) {
            e.setCancelled(true);
        }
    }
    
    @EventHandler
    public void onEntityDeath(EntityDeathEvent e) {
        if (!isTCRunning()) return;

        Entity ent = e.getEntity();
        if (!(ent instanceof Snowman)) return;
        Snowman dead = (Snowman)ent;

        if (!dead.hasMetadata("team")) return;

        String team = null;
        for (MetadataValue md : dead.getMetadata("team")) {
            if (md.getOwningPlugin() == plugin) {
                team = md.asString();
                break;
            }
        }
        if (team == null) return;

        if (team.equalsIgnoreCase(redTeam.getName())) {
            redGolems--;
        } else if (team.equalsIgnoreCase(blueTeam.getName())) {
            blueGolems--;
        } else {
            return; // unknown team
        }

        checkEnd();
    }
