    private void announceWinner(TeamData winner) {
    	removeAllGolems();
    	endGame();
    	stopAntiFenceWaterTask();
    	Bukkit.broadcastMessage(prefix + ChatColor.GOLD + winner.getName() + " has won!");
    	Location victoryLocation = new Location(Bukkit.getWorld("Victory"), 4.0, 100.0, 2.0);
        Location defeatLocation  = new Location(Bukkit.getWorld("Victory"), 3.0,  99.0, -10.0);
        Location lobby = new Location(Bukkit.getWorld("world"), 242, 101, 1344);
        for (Player p: Bukkit.getOnlinePlayers()) {
        	p.setGameMode(GameMode.ADVENTURE);
        	p.setFlying(false);
        	p.setAllowFlight(false);
        	p.getInventory().setHelmet(new ItemStack(Material.AIR));
            p.getInventory().setChestplate(new ItemStack(Material.AIR));
            p.getInventory().setLeggings(new ItemStack(Material.AIR));
            p.getInventory().setBoots(new ItemStack(Material.AIR));
            p.removePotionEffect(PotionEffectType.SPEED);
            boardm.setLobbyBoard(p);
            boardm.startAnimator(p);
        	 if (winner.hasMember(p)) {
                p.teleport(victoryLocation);
                p.getInventory().clear();
                Coins.addCoins(p, 30);
                XpHandler.addXp(p, 50);
                boardm.updateLobbyCoins(p);
                p.sendMessage(prefix + ChatColor.GRAY + "Won: +30 coins");
                p.sendMessage(prefix + ChatColor.GRAY + "Won +50 XP");
                XpHandler.addXp(p, 30);
            } else {
                Bukkit.getScheduler().runTask(plugin, () -> {
                p.teleport(defeatLocation); });
                XpHandler.addXp(p, 10);
                p.sendMessage(prefix + ChatColor.GRAY + "Participation: +10 XP");
                p.getInventory().clear();
                ItemStack eggs = new ItemStack(Material.EGG, 16);
                ItemMeta meta = eggs.getItemMeta();
                meta.setDisplayName(ChatColor.YELLOW + "Loser Eggs");
                meta.setLore(Collections.singletonList(ChatColor.GRAY + "Throw at winner!"));
                eggs.setItemMeta(meta);
                p.getInventory().addItem(eggs);
            }
        }
  new BukkitRunnable() {
            int count = 20;
            @Override public void run() {
                if (count-- <= 0) {
                    cancel();
                    Bukkit.getOnlinePlayers().forEach(p -> {
                        p.teleport(lobby);
                        giveDefaultItems(p);
                        Levels.ensurePlayerExists(p);
                        level.updateLevelFromXp(p);
                        if (game.isHost(p) || game.isCohost(p)) {
                            ItemStack melon = new ItemStack(Material.MELON);
                            ItemMeta meta = melon.getItemMeta();
                            meta.setDisplayName(ChatColor.LIGHT_PURPLE + "Game Menu");
                            melon.setItemMeta(meta);
                            p.getInventory().setItem(8, melon);
                            clearAllTeams();
                        }
                    });
                    game.stopGame();
                }
                playEffectsAndFireworks(winner);
            }
        }.runTaskTimer(plugin, 0L, 10L);
        
    }
    private void playEffectsAndFireworks(TeamData team) {
        for (UUID uuid: team.getMemberUUIDs()) {
            Player player = Bukkit.getPlayer(uuid);
            if (player != null && player.isOnline()) {
                Location loc = player.getLocation();
                player.playSound(loc, Sound.CHICKEN_EGG_POP, 4.0F, 5.0F);
                player.playEffect(loc, Effect.FIREWORKS_SPARK, null);
                spawnFirework(loc, Color.YELLOW, Color.RED);
                spawnFirework(loc, Color.LIME, Color.BLUE);
            }
        }
    }
    
