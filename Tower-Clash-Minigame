   public void handleKitSelectorClick(InventoryClickEvent e) {
       if (!(e.getWhoClicked() instanceof Player)) return;
       Player p = (Player) e.getWhoClicked();
       if (!e.getView().getTitle().equals(GUI_TITLE)) return;
       e.setCancelled(true);
       int slot = e.getRawSlot();
       if (slot < 0 || slot >= KIT_NAMES.length) return;
       String kitName = KIT_NAMES[slot];
       CosList selectedCos = CosList.valueOf(kitName.toUpperCase());
       List<CosList> cosmetics = new ArrayList<>(cmanager.getCosmetics(p));
       if (!cosmetics.contains(selectedCos) && !isStaff(p)) {
           p.closeInventory();
           p.sendMessage(prefix + ChatColor.RED + "You haven't unlocked the " + ChatColor.GOLD + ChatColor.BOLD + kitName + ChatColor.RED + " kit!");
           p.playSound(p.getLocation(), Sound.BAT_DEATH, 2, 2);
           return;
       }
       p.setMetadata("selected_kit", new FixedMetadataValue(plugin, kitName));
       p.sendMessage(prefix + ChatColor.GRAY + "Selected " + ChatColor.BOLD + kitName + ChatColor.GRAY + " Kit");
       TCKits.put(p.getUniqueId(), kitName);
       p.playSound(p.getLocation(), Sound.NOTE_PLING, 2, 2);
       p.closeInventory();
   }
   
