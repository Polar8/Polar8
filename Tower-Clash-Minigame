    private void startBlazeWaterTask() {
        if (blazeWaterTask != null) {
            blazeWaterTask.cancel();
        }

        blazeWaterTask = new BukkitRunnable() {
            @Override
            public void run() {
                if (!isTCRunning()) {
                    cancel();
                    blazeWaterTask = null;
                    return;
                }

                World w = Bukkit.getWorld("TowerClash");
                if (w == null) return;

                for (Blaze blaze : w.getEntitiesByClass(Blaze.class)) {
                    Block block = blaze.getLocation().getBlock();

                    if (block.getType() == Material.WATER
                            || block.getType() == Material.STATIONARY_WATER) {

                        blaze.damage(10.0);

                        Location up = blaze.getLocation().clone().add(0, 3, 0);
                        blaze.teleport(up);
                        blaze.setVelocity(new Vector(0, 0.2, 0));
                    }
                }
            }
        }.runTaskTimer(plugin, 0L, 10L);
    }
    
    public boolean consumeJuice(Player p, int cost) {
        UUID id = p.getUniqueId();
        int juice = juiceMap.getOrDefault(id, 0);
        if (juice < cost) {
            p.sendMessage(prefix + ChatColor.RED + "Not enough juice you need " + ChatColor.BOLD + cost + "");
            p.playSound(p.getLocation(), Sound.SLIME_ATTACK, 2, 2);
            return false;
        }
        juiceMap.put(id, juice - cost);
        return true;
    }
    
