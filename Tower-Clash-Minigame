    private void applyOvertimeZombieAI(final Zombie zombie) {
        new BukkitRunnable() {
            @Override
            public void run() {
                if (!isTCRunning() || zombie == null || !zombie.isValid() || zombie.isDead()) {
                    cancel();
                    return;
                }

                LivingEntity target = getNearestTowerClashMob(zombie.getLocation(), 25);

                if (target == null) return;

                Vector dir = target.getLocation().toVector()
                        .subtract(zombie.getLocation().toVector());

                dir.setY(0);

                if (dir.lengthSquared() > 0) {
                    zombie.setVelocity(dir.normalize().multiply(0.28));
                }

                if (zombie.getLocation().distanceSquared(target.getLocation()) <= 2.0 * 2.0) {
                    target.damage(3.0, zombie);
                }
            }
        }.runTaskTimer(plugin, 0L, 10L);
    }
    
    private LivingEntity getNearestTowerClashMob(Location from, double range) {
        LivingEntity closest = null;
        double best = range * range;

        for (Entity e : from.getWorld().getNearbyEntities(from, range, range, range)) {
            if (!(e instanceof LivingEntity)) continue;
            if (e instanceof Player) continue;
            if (e instanceof Zombie) continue;
            if (e.hasMetadata("overtimeZombie")) continue;

            if (!e.hasMetadata("team")) continue;

            double dist = e.getLocation().distanceSquared(from);

            if (dist < best) {
                best = dist;
                closest = (LivingEntity) e;
            }
        }

        return closest;
    }
    
    
    private BukkitRunnable antiFenceWaterTask;

    public void startAntiFenceWaterTask() {
        this.antiFenceWaterTask = new BukkitRunnable() {
            @Override
            public void run() {
                for (Player player: Bukkit.getOnlinePlayers()) {
                    Location loc = player.getLocation();
                    Block blockBelow = loc.clone().subtract(0, 1, 0).getBlock();
                    if (isInWater(player) ||
                        isWoodFence(blockBelow.getType()) ||
                        isSmoothSandstone(blockBelow) ||
                        isSpruceWood(blockBelow)) {

                        Location targetSpawn = getTeamSpawn(player);

                        if (targetSpawn != null) {
                            Vector direction = targetSpawn.toVector().subtract(loc.toVector()).setY(0).normalize().multiply(1.5);
                            direction.setY(0.3);
                            player.setVelocity(direction);
                        }
                    }
                }
            }
        };
        this.antiFenceWaterTask.runTaskTimer(this.plugin, 0L, 1L);
    }

    public void stopAntiFenceWaterTask() {
        if (this.antiFenceWaterTask != null) {
            this.antiFenceWaterTask.cancel();
            this.antiFenceWaterTask = null;
        }
    }

    public void assignPlayer(Player player) {
        TeamData team = teams.get(nextTeamIndex);
        nextTeamIndex = (nextTeamIndex + 1) % teams.size();
        team.addMember(player);
        playerTeams.put(player.getUniqueId(), team); // Track assigned team
    }
    
    
    private void initPlayer(Player p) {
