    @EventHandler
    public void onPluginDisable(PluginDisableEvent e) {
    	if (!isTCRunning()) return;
    	endGame();
        if (e.getPlugin().equals(plugin)) {
        	clearAllTeams();
        	removeAllGolems();
          stopAntiFenceWaterTask();
        	game.stopGame();
        }
    }
    
    @EventHandler
    public void onPlayerQuit(PlayerQuitEvent e) {
        Player quitter = e.getPlayer();
        if (!isTCRunning()) return;
        long redRemaining = redTeam.getPlayers().stream().filter(Player::isOnline).filter(p -> !p.equals(quitter)).count();
        long blueRemaining = blueTeam.getPlayers().stream().filter(Player::isOnline).filter(p -> !p.equals(quitter)).count();
        if (redRemaining == 0 && blueRemaining > 0) {
            announceWinner(blueTeam);
        } else if (blueRemaining == 0 && redRemaining > 0) {
            announceWinner(redTeam);
        } else if (redRemaining == 0 && blueRemaining == 0) {
        	clearAllTeams();
        	removeAllGolems();
        	game.stopGame();
        	endGame();
        }
    }
