  }

	private void startJuiceTask() {
        if (juiceTask != null) {
            juiceTask.cancel();
        }

        juiceTask = new BukkitRunnable() {
            @Override
            public void run() {
                if (!isTCRunning()) {
                    cancel();
                    juiceTask = null;
                    return;
                }

                tickCounter++;

                for (TeamData team: getTeams()) {
                    for (UUID uuid: team.getMemberUUIDs()) {
                        Player p = Bukkit.getPlayer(uuid);
                        if (p == null || !p.isOnline()) continue;

                        int currentJuice = juiceMap.getOrDefault(uuid, 0);

                        if (tickCounter % 8 == 0) {
                            currentJuice = Math.min(currentJuice + getJuiceGainAmount(), 10);
                            juiceMap.put(uuid, currentJuice);
                        }
                        int filled = currentJuice;
                        int empty = 10 - filled;
                        String barText = ChatColor.LIGHT_PURPLE + "" + ChatColor.BOLD + "Juice: " + ChatColor.DARK_PURPLE + repeat("█", filled) + ChatColor.DARK_GRAY + repeat("-", empty) + ChatColor.GRAY + " (" + currentJuice + "/10)";
                        String last = lastBars.get(uuid);
                        if (!barText.equals(last)) {
                            new ActionBar(barText).sendToPlayer(p);
                            lastBars.put(uuid, barText);
                        } else {
                            new ActionBar(last).sendToPlayer(p);
                        }
                    }
                }

                if (tickCounter >= 1000) tickCounter = 0;
            }
        }.runTaskTimer(plugin, 0L, 10L);
    }
    	
