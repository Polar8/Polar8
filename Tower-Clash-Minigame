    public void TCStart() {
        String current = game.getCurrentGame();
        if (current == null
                || !ChatColor.stripColor(current).equalsIgnoreCase("Tower Clash")) {
            return;
        }
        juiceMap.clear();
        lastBars.clear();
        overtimeStarted = false;
        tickCounter = 0;
        towerClashTimeLeft = 300;
        startAntiFenceWaterTask();
        removeOvertimeZombies();
        removeAllVillagersAndSlimes();
        removeAllGolems();
        startBlazeWaterTask();
        World world = Bukkit.getWorld("TowerClash");
        if (world == null) return;
        Location redSpawn = new Location(world, 141, 87, -52);
        Location blueSpawn = new Location(world, 178, 87, -51);
        for (Player p: Bukkit.getOnlinePlayers()) {
        	clearArmorAndEffects(p);
            if (!playerTeams.containsKey(p.getUniqueId())) {
                assignPlayer(p);
            }
        }

        game.setInGame(true);
        startGame();

        for (TeamData team: getTeams()) {
            for (UUID uuid: team.getMemberUUIDs()) {
                Player p = Bukkit.getPlayer(uuid);
                if (p == null || !p.isOnline()) continue;
                String kit = TCKits.getOrDefault(uuid, "Bones");
                TCKits.put(uuid, kit);
                Location spawn = team.getName().equalsIgnoreCase("Red") ? redSpawn : blueSpawn;
                p.getInventory().clear();
                p.teleport(spawn);
                initPlayer(p);
        	    p.performCommand("map");
                boardm.setTowerClashBoard(p, kit, formatTime(towerClashTimeLeft), getJuiceMultiplierText());

              new BukkitRunnable() {
                @Override
                public void run() {
                  team.equipTeamArmor(p);
                    }
                }.runTaskLater(plugin, 1L);
            }
        }

        String announce = prefix + ChatColor.GREEN + "Tower Clash has begun, defend your towers!";

        for (Player p: Bukkit.getOnlinePlayers()) {
            new ActionBar(announce).sendToPlayer(p);
            p.setGameMode(GameMode.SURVIVAL);
            p.addPotionEffect(new PotionEffect(PotionEffectType.SPEED, Integer.MAX_VALUE, 1), true);
        }

        startTowerClashTimer();
        startJuiceTask();
    }
    
